<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: el estado de una acción planificada lo decide quien
         administra, no el despliegue. Sin esto, cada actualización del módulo
         devolvía los crons a su definición original y apagaba la
         sincronización de etapas que alguien había encendido a mano. -->
    <data noupdate="1">

        <!-- El intervalo es la red, no el motor: desde 18.0.5.4.0 cada lote
             de eventos dispara el procesado al instante desde ingest_batch.
             Este paso periódico queda para dos cosas, un disparo que se
             pierda y los eventos en error que esperan otro intento. -->
        <record id="ir_cron_process_hubspot_events" model="ir.cron">
            <field name="name">HubSpot: procesar eventos pendientes</field>
            <field name="model_id" ref="model_hubspot_webhook_event" />
            <field name="state">code</field>
            <field name="code">model._cron_process_events()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

        <!-- Este sí es por reloj, y no puede ser de otra manera: existe
             precisamente porque el webhook no avisa. Va a buscar lo que nadie
             le ha contado. -->
        <record id="ir_cron_sweep_hubspot_deals" model="ir.cron">
            <field name="name">HubSpot: buscar negocios ganados (respaldo del webhook)</field>
            <field name="model_id" ref="model_hubspot_webhook_event" />
            <field name="state">code</field>
            <field name="code">model._cron_sweep_deals()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

        <record id="ir_cron_sync_hubspot_stages" model="ir.cron">
            <field name="name">HubSpot: sincronizar etapas de los pipelines</field>
            <field name="model_id" ref="model_hubspot_deal_stage" />
            <field name="state">code</field>
            <field name="code">model._cron_sync_stages()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>

    </data>
</odoo>
