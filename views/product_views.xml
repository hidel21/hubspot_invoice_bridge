<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_view_form_hubspot" model="ir.ui.view">
        <field name="name">product.product.form.hubspot</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="hubspot_product_id"
                    groups="account.group_account_invoice" />
            </xpath>
        </field>
    </record>

    <record id="product_product_view_search_hubspot" model="ir.ui.view">
        <field name="name">product.product.search.hubspot</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="hubspot_product_id" string="ID de HubSpot" />
            </xpath>
        </field>
    </record>

</odoo>