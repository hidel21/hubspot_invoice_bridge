<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_hubspot_manager" model="res.groups">
        <field name="name">HubSpot: administrador de la integración</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Permite configurar la integración con HubSpot,
            revisar la cola de eventos y reprocesar los que hayan fallado.</field>
    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_hubspot_manager'))]"/>
    </record>

</odoo>
